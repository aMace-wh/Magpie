{
  "name": "magpie",
  "private": true,
  "version": "0.1.0",
  "description": "Magpie — save links, videos, recipes, places and ideas, then actually do them. An installable, offline-first web app.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
