# Response headers for Netlify and Cloudflare Pages (GitHub Pages ignores this file).
# The service worker and manifest must be re-checked on every visit so updates arrive promptly;
# built assets have content hashes in their names and never change.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
